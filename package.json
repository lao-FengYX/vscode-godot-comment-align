{
  "name": "godot-comment-align",
  "displayName": "godot-comment-align",
  "description": "Align GDScript comments in Go style after formatting",
  "version": "0.0.1",
  "author": "Lao Feng",
  "publisher": "LaoFeng",
  "engines": {
    "vscode": "^1.75.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lao-FengYX/vscode-godot-comment-align"
  },
  "bugs": {
    "email": "laofyx@163.com",
    "url": "https://github.com/lao-FengYX/vscode-godot-comment-align/issues"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:gdscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "godot-comment-align.formatAndAlign",
        "title": "Format Document with Comment Align",
        "category": "Godot"
      }
    ],
    "keybindings": [
      {
        "command": "godot-comment-align.formatAndAlign",
        "key": "Shift+Alt+F",
        "when": "editorTextFocus && editorLangId == gdscript"
      }
    ],
    "configuration": {
      "title": "Godot Comment Align",
      "properties": {
        "godotCommentAlign.commentIndentSize": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of spaces to use as indentation before the '#' symbol in comments"
        },
        "godotCommentAlign.indentType": {
          "type": "string",
          "default": "tab",
          "enum": [
            "tab",
            "space"
          ],
          "description": "Indent type to use for comments"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.75.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
